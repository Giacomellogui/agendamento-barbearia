# Copie para .env e escolha a senha para acessar o painel.
BARBEIRO_SENHA=

# Credenciais compartilhadas pelos recursos de WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Avisos de reagendamento para o barbeiro.
WHATSAPP_BARBEIRO_NUMERO=
WHATSAPP_TEMPLATE=
# WHATSAPP_GRAPH_VERSION=v27.0

# E-mail de confirmação e de recuperação de senha do cliente, via Resend.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://127.0.0.1:3000

# Deixe vazio para usar SQLite localmente. Na hospedagem, use a URL do PostgreSQL.
DATABASE_URL=
